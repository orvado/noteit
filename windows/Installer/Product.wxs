<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NoteIt" Manufacturer="NoteIt" Version="1.0.0" UpgradeCode="{B6AAE8D3-0E73-4ED2-8B4A-0D2A8D89D857}" Scope="perMachine">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of NoteIt is already installed." />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NoteIt" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuNoteItFolder" Name="NoteIt" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainApplication" Title="NoteIt" Level="1">
      <ComponentGroupRef Id="PublishedAppFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="..\NoteIt\AppIcon.ico" />

    <ComponentGroup Id="PublishedAppFiles">
      <Files Include="$(var.PublishDir)\**\*" Directory="INSTALLFOLDER" />
    </ComponentGroup>

    <Component Id="StartMenuShortcutComponent" Directory="ProgramMenuNoteItFolder">
      <Shortcut Id="StartMenuShortcut" Name="NoteIt" Target="[INSTALLFOLDER]NoteIt.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" IconIndex="0" />
      <RemoveFolder Id="RemoveStartMenuFolder" Directory="ProgramMenuNoteItFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\NoteIt" Name="StartMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut" Name="NoteIt" Target="[INSTALLFOLDER]NoteIt.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" IconIndex="0" />
      <RegistryValue Root="HKCU" Key="Software\NoteIt" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
