<Application x:Class="NoteIt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
  <Application.Resources>
    <!-- Shared brushes flipped by App.ApplyTheme -->
    <SolidColorBrush x:Key="NoteItEditorBackground" Color="White"/>
    <SolidColorBrush x:Key="NoteItEditorForeground" Color="Black"/>
    <SolidColorBrush x:Key="NoteItChromeBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="NoteItChromeForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="NoteItGutterBackground" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="NoteItGutterForeground" Color="#808080"/>
    <SolidColorBrush x:Key="NoteItTabBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="NoteItTabForeground" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="NoteItTabSelectedBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NoteItTabSelectedForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="NoteItTabHoverBackground" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="NoteItTitleBarBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="NoteItTitleBarForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="NoteItAccent" Color="#0078D7"/>
    <SolidColorBrush x:Key="NoteItSeparator" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="NoteItStatusBarBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="NoteItStatusBarForeground" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="NoteItDisabledForeground" Color="#6D6D6D"/>
    <SolidColorBrush x:Key="NoteItMenuPopupBackground" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="NoteItMenuPopupForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="NoteItMenuItemHoverBackground" Color="#C9C9C9"/>
    <SolidColorBrush x:Key="NoteItMenuItemHoverForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="NoteItMenuItemBorder" Color="#CFCFCF"/>

    <!-- Default control styles to match Windows 11 -->
    <Style TargetType="Menu">
      <Setter Property="Background" Value="{DynamicResource NoteItChromeBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource NoteItChromeForeground}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- MenuItem: custom template so the dropdown popup uses our themed brushes.
         WPF's default MenuItem template hardcodes a light-gray popup background
         which makes dark-mode menus unreadable. This template replaces it. -->
    <Style TargetType="MenuItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource NoteItChromeForeground}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,3,8,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <!-- The top-level menu item (File, Edit, View, etc.) -->
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- When this is a top-level item (parent is a Menu), show as a button -->
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                      <Border x:Name="root"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <ContentPresenter Grid.Column="0"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            VerticalAlignment="Center"/>
                          <Popup x:Name="PART_Popup"
                                 Grid.Column="0"
                                 AllowsTransparency="True"
                                 IsOpen="{TemplateBinding IsSubmenuOpen}"
                                 Placement="Bottom"
                                 VerticalOffset="2"
                                 PopupAnimation="Fade">
                            <Border Background="{DynamicResource NoteItMenuPopupBackground}"
                                    BorderBrush="{DynamicResource NoteItMenuItemBorder}"
                                    BorderThickness="1"
                                    Padding="1"
                                    MinWidth="200">
                              <StackPanel>
                                <ItemsPresenter/>
                              </StackPanel>
                            </Border>
                          </Popup>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="root" Property="Background"
                                  Value="{DynamicResource NoteItMenuItemHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="root" Property="Background"
                                  Value="{DynamicResource NoteItMenuItemHoverBackground}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <!-- Submenu item (inside the dropdown) -->
              <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                      <Border x:Name="root"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <ContentPresenter Grid.Column="0"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1"
                                     Text="{TemplateBinding InputGestureText}"
                                     Foreground="{DynamicResource NoteItDisabledForeground}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="20,0,0,0"/>
                          <Popup x:Name="PART_Popup"
                                 Grid.Column="0"
                                 AllowsTransparency="True"
                                 IsOpen="{TemplateBinding IsSubmenuOpen}"
                                 Placement="Right"
                                 VerticalOffset="-2"
                                 PopupAnimation="Fade">
                            <Border Background="{DynamicResource NoteItMenuPopupBackground}"
                                    BorderBrush="{DynamicResource NoteItMenuItemBorder}"
                                    BorderThickness="1"
                                    Padding="1"
                                    MinWidth="200">
                              <StackPanel>
                                <ItemsPresenter/>
                              </StackPanel>
                            </Border>
                          </Popup>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="root" Property="Background"
                                  Value="{DynamicResource NoteItMenuItemHoverBackground}"/>
                          <Setter Property="Foreground"
                                  Value="{DynamicResource NoteItMenuItemHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Foreground"
                                  Value="{DynamicResource NoteItDisabledForeground}"/>
                          <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <!-- Submenu item without children (leaf) -->
              <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                      <Border x:Name="root"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <ContentPresenter Grid.Column="0"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1"
                                     Text="{TemplateBinding InputGestureText}"
                                     Foreground="{DynamicResource NoteItDisabledForeground}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="20,0,0,0"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="root" Property="Background"
                                  Value="{DynamicResource NoteItMenuItemHoverBackground}"/>
                          <Setter Property="Foreground"
                                  Value="{DynamicResource NoteItMenuItemHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Foreground"
                                  Value="{DynamicResource NoteItDisabledForeground}"/>
                          <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <!-- Top-level leaf (rare: top-level item with no children) -->
              <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                      <Border x:Name="root"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="root" Property="Background"
                                  Value="{DynamicResource NoteItMenuItemHoverBackground}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource NoteItDisabledForeground}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Separator inside menus -->
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource NoteItSeparator}"/>
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource NoteItChromeBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource NoteItChromeForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource NoteItSeparator}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="{DynamicResource NoteItStatusBarBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource NoteItStatusBarForeground}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="ToolBar">
      <Setter Property="Background" Value="{DynamicResource NoteItChromeBackground}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Caption button style (min/max/close) -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource NoteItTitleBarForeground}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NoteItTabHoverBackground}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NoteItSeparator}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Close caption button (red on hover) -->
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F1707A"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title bar button (e.g. new tab "+") -->
    <Style x:Key="TitleBarButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource NoteItTitleBarForeground}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NoteItTabHoverBackground}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NoteItSeparator}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
