<Window x:Class="NoteIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteIt" Width="960" Height="640" MinWidth="640" MinHeight="420"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40"
                  GlassFrameThickness="0"
                  ResizeBorderThickness="4"
                  CornerRadius="8"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border x:Name="WindowRoot" Background="{DynamicResource NoteItChromeBackground}" Margin="0">
    <DockPanel>
      <!-- Custom Title Bar (host the system caption buttons + tabs + window controls) -->
      <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource NoteItTitleBarBackground}"
              BorderBrush="{DynamicResource NoteItSeparator}" BorderThickness="0,0,0,1"
              x:Name="TitleBar">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- App icon + title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="NoteIt" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource NoteItTitleBarForeground}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
          </StackPanel>

          <!-- Tab bar (centered in title bar) -->
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                        PreviewMouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="0,0,0,0"
                        VerticalAlignment="Center"/>
          </ScrollViewer>

          <!-- New tab + window control buttons -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <Button Content="+" Width="36" Height="28" ToolTip="New tab (Ctrl+T)"
                    Click="OnNewTab" Style="{StaticResource TitleBarButton}"/>
            <!-- System caption buttons -->
            <Button x:Name="MinButton" Width="46" Height="28" Click="OnMinimize"
                    Style="{StaticResource CaptionButton}" Content="&#xE921;"
                    FontFamily="Segoe Fluent Icons" FontSize="10"
                    ToolTip="Minimize"/>
            <Button x:Name="MaxButton" Width="46" Height="28" Click="OnMaximizeRestore"
                    Style="{StaticResource CaptionButton}" Content="&#xE922;"
                    FontFamily="Segoe Fluent Icons" FontSize="10"
                    ToolTip="Maximize"/>
            <Button x:Name="RestoreButton" Width="46" Height="28" Click="OnMaximizeRestore"
                    Style="{StaticResource CaptionButton}" Content="&#xE923;"
                    FontFamily="Segoe Fluent Icons" FontSize="10"
                    Visibility="Collapsed"
                    ToolTip="Restore"/>
            <Button x:Name="CloseButton" Width="46" Height="28" Click="OnCloseWindow"
                    Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons" FontSize="10"
                    ToolTip="Close"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Menu -->
      <Menu DockPanel.Dock="Top" x:Name="MainMenu">
        <MenuItem Header="_File">
          <MenuItem Header="New Tab" InputGestureText="Ctrl+T" Click="OnNewTab"/>
          <MenuItem Header="New Window" InputGestureText="Shift+Ctrl+N" Click="OnNewWindow"/>
          <Separator/>
          <MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="OnOpen"/>
          <MenuItem Header="Quick Open…" InputGestureText="Ctrl+P" Click="OnQuickOpen"/>
          <MenuItem Header="Open Recent" x:Name="RecentMenu"/>
          <Separator/>
          <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="OnSave"/>
          <MenuItem Header="Save As…" InputGestureText="Shift+Ctrl+S" Click="OnSaveAs"/>
          <MenuItem Header="Save All" InputGestureText="Alt+Ctrl+S" Click="OnSaveAll"/>
          <MenuItem Header="Revert to Saved" Click="OnRevert"/>
          <Separator/>
          <MenuItem Header="Export as PDF…" InputGestureText="Shift+Ctrl+E" Click="OnExportPdf"/>
          <MenuItem Header="Export as Text…" Click="OnExportText"/>
          <MenuItem Header="Print…" InputGestureText="Shift+Ctrl+P" Click="OnPrint"/>
          <Separator/>
          <MenuItem Header="Close Tab" InputGestureText="Ctrl+W" Click="OnCloseTab"/>
          <MenuItem Header="E_xit" Click="OnExit"/>
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo"/>
          <MenuItem Header="Redo" InputGestureText="Shift+Ctrl+Z" Command="ApplicationCommands.Redo"/>
          <Separator/>
          <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut"/>
          <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy"/>
          <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste"/>
          <MenuItem Header="Select All" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll"/>
          <Separator/>
          <MenuItem Header="Find…" InputGestureText="Ctrl+F" Click="OnShowFind"/>
          <MenuItem Header="Find and Replace…" InputGestureText="Ctrl+H" Click="OnShowReplace"/>
          <MenuItem Header="Find Next" InputGestureText="Ctrl+G" Click="OnFindNext"/>
          <MenuItem Header="Find Previous" InputGestureText="Shift+Ctrl+G" Click="OnFindPrev"/>
          <MenuItem Header="Go to Line…" InputGestureText="Ctrl+L" Click="OnGoToLine"/>
          <Separator/>
          <MenuItem Header="Toggle Word Wrap" InputGestureText="Alt+Ctrl+L" Click="OnToggleWrap"/>
          <MenuItem Header="Toggle Line Numbers" InputGestureText="Shift+Ctrl+L" Click="OnToggleLineNumbers"/>
          <MenuItem Header="Toggle Spellcheck" InputGestureText="Alt+Ctrl+K" Click="OnToggleSpell"/>
          <Separator/>
          <MenuItem Header="Insert Snippet…" InputGestureText="Ctrl+J" Click="OnSnippets"/>
          <MenuItem Header="Manage Snippets…" Click="OnSnippets"/>
        </MenuItem>
        <MenuItem Header="_Format">
          <MenuItem Header="Bold" InputGestureText="Ctrl+B" Click="OnBold"/>
          <MenuItem Header="Italic" InputGestureText="Ctrl+I" Click="OnItalic"/>
          <MenuItem Header="Underline" InputGestureText="Ctrl+U" Click="OnUnderline"/>
          <Separator/>
          <MenuItem Header="Formatting is OFF by default (plain-text). Enable per-document via status bar Format checkbox." IsEnabled="False"/>
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="Appearance: System" Click="OnThemeSystem"/>
          <MenuItem Header="Appearance: Light" Click="OnThemeLight"/>
          <MenuItem Header="Appearance: Dark" InputGestureText="Alt+Ctrl+D" Click="OnThemeDark"/>
          <Separator/>
          <MenuItem Header="Increase Font Size" InputGestureText="Ctrl++" Click="OnFontBigger"/>
          <MenuItem Header="Decrease Font Size" InputGestureText="Ctrl+-" Click="OnFontSmaller"/>
          <MenuItem Header="Reset Font Size" InputGestureText="Ctrl+0" Click="OnFontReset"/>
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="Settings…" InputGestureText="Ctrl+," Click="OnSettings"/>
          <MenuItem Header="About NoteIt" Click="OnAbout"/>
        </MenuItem>
      </Menu>

      <!-- Status bar -->
      <StatusBar DockPanel.Dock="Bottom" x:Name="StatusBar">
        <StatusBarItem><TextBlock x:Name="CursorText" Text="Ln 1, Col 1" MinWidth="90"/></StatusBarItem>
        <Separator/>
        <StatusBarItem><TextBlock x:Name="WordText" Text="0 words" MinWidth="60"/></StatusBarItem>
        <Separator/>
        <StatusBarItem><TextBlock x:Name="LineText" Text="1 lines" MinWidth="50"/></StatusBarItem>
        <Separator/>
        <StatusBarItem><TextBlock x:Name="SavedText" Text="Saved" MinWidth="60"/></StatusBarItem>
        <Separator/>
        <StatusBarItem><TextBlock x:Name="FileText" Text="" MaxWidth="260" TextTrimming="CharacterEllipsis"/></StatusBarItem>
        <StatusBarItem HorizontalAlignment="Right" HorizontalContentAlignment="Right">
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="WrapCheck" Content="Wrap" Margin="8,0" ToolTip="Wrap long lines (Alt+Ctrl+L)" Checked="OnWrapChecked" Unchecked="OnWrapChecked"/>
            <CheckBox x:Name="SpellCheck" Content="Spell" Margin="8,0" ToolTip="Spellcheck (Alt+Ctrl+K)" Checked="OnSpellChecked" Unchecked="OnSpellChecked"/>
            <CheckBox x:Name="FormatCheck" Content="Format" Margin="8,0" ToolTip="Basic formatting (bold/italic) — off by default" Checked="OnFormatChecked" Unchecked="OnFormatChecked"/>
            <TextBlock x:Name="FontText" Margin="8,0" Foreground="Gray"/>
          </StackPanel>
        </StatusBarItem>
      </StatusBar>

      <DockPanel>
        <!-- Find / Replace bar -->
        <Border DockPanel.Dock="Top" x:Name="FindBar" Visibility="Collapsed"
                Background="{DynamicResource NoteItChromeBackground}" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource NoteItSeparator}" Padding="8,6">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="&#xE711;" Width="26" ToolTip="Close (Esc)"
                      Click="OnCloseFind" Background="Transparent" BorderThickness="0"
                      FontFamily="Segoe Fluent Icons" FontSize="10"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <TextBox x:Name="FindBox" Width="220" Margin="0,0,6,0" ToolTip="Find" TextChanged="OnFindTextChanged"/>
                <ToggleButton x:Name="CaseBtn" Content="Aa" Margin="0,0,4,0" ToolTip="Case sensitive" Checked="OnSearchOptChanged" Unchecked="OnSearchOptChanged"/>
                <ToggleButton x:Name="RegexBtn" Content=".*" Margin="0,0,4,0" ToolTip="Regular expression" Checked="OnSearchOptChanged" Unchecked="OnSearchOptChanged"/>
                <ToggleButton x:Name="WordBtn" Content="W" Margin="0,0,4,0" ToolTip="Whole word" Checked="OnSearchOptChanged" Unchecked="OnSearchOptChanged"/>
                <Button Content="&#xE74B;" ToolTip="Find previous (Shift+Ctrl+G)" Click="OnFindPrev" Margin="0,0,4,0"
                        FontFamily="Segoe Fluent Icons" FontSize="10"/>
                <Button Content="&#xE74A;" ToolTip="Find next (Ctrl+G)" Click="OnFindNext" Margin="0,0,4,0"
                        FontFamily="Segoe Fluent Icons" FontSize="10"/>
                <Button Content="&#xE748;" ToolTip="Toggle replace (Ctrl+H)" Click="OnToggleReplaceBar" Margin="0,0,8,0"
                        FontFamily="Segoe Fluent Icons" FontSize="10"/>
                <TextBlock x:Name="MatchCount" VerticalAlignment="Center" Foreground="Gray" MinWidth="80"/>
              </StackPanel>
            </DockPanel>
            <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,6,0,0">
              <TextBlock Text="&#xE748;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10"/>
              <TextBox x:Name="ReplaceBox" Width="220" Margin="0,0,6,0" ToolTip="Replace" TextChanged="OnReplaceTextChanged"/>
              <Button Content="Replace" Click="OnReplaceCurrent" Margin="0,0,4,0"/>
              <Button Content="Replace All" Click="OnReplaceAll" Margin="0,0,8,0"/>
              <CheckBox x:Name="WrapSearchCheck" Content="Wrap" IsChecked="True" VerticalAlignment="Center" Checked="OnSearchOptChanged" Unchecked="OnSearchOptChanged"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Editor: gutter + RichTextBox -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GutterColumn" Width="48"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ScrollViewer x:Name="GutterScroll" Grid.Column="0" VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        Background="{DynamicResource NoteItGutterBackground}">
            <TextBlock x:Name="GutterText" Text="1" Padding="8,6,8,0"
                       Foreground="{DynamicResource NoteItGutterForeground}"
                       Background="Transparent" TextAlignment="Right"/>
          </ScrollViewer>
          <RichTextBox x:Name="Editor" Grid.Column="1"
                       AcceptsReturn="True" AcceptsTab="False"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       SpellCheck.IsEnabled="True"
                       Background="{DynamicResource NoteItEditorBackground}"
                       Foreground="{DynamicResource NoteItEditorForeground}"
                       BorderThickness="0" Padding="6,4"
                       TextChanged="OnEditorTextChanged"
                       SelectionChanged="OnEditorSelectionChanged"
                       PreviewKeyDown="OnEditorPreviewKeyDown"
                       AllowDrop="True" PreviewDragOver="OnEditorDragOver" Drop="OnEditorDrop"
                       PreviewMouseWheel="OnEditorMouseWheel"
                       ContextMenuOpening="OnEditorContextMenu">
            <RichTextBox.ContextMenu>
              <ContextMenu x:Name="EditorContextMenu">
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut"/>
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste"/>
                <MenuItem Header="Select All" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll"/>
                <Separator/>
                <MenuItem Header="Find…" InputGestureText="Ctrl+F" Click="OnShowFind"/>
                <MenuItem Header="Go to Line…" InputGestureText="Ctrl+L" Click="OnGoToLine"/>
                <Separator/>
                <MenuItem Header="Insert Snippet…" InputGestureText="Ctrl+J" Click="OnSnippets"/>
              </ContextMenu>
            </RichTextBox.ContextMenu>
          </RichTextBox>
        </Grid>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
